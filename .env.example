# Copy this file to .env and edit the values

# Port the server listens on
PORT=8443

# Bind address. Use 0.0.0.0 to be reachable over Tailscale, 127.0.0.1 for local-only testing
HOST=0.0.0.0

# Long random secret used to sign session/JWT tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Root directory the File Manager is allowed to browse. Everything outside this
# directory is inaccessible, even to an authenticated user.
FILE_ROOT=./data/files

# Directories the Media Center scans (comma separated). Can be the same as FILE_ROOT.
MEDIA_DIRS=./data/files

# Session cookie lifetime, in hours
SESSION_HOURS=12

# Set to "true" once you are serving over HTTPS/Tailscale so cookies get the Secure flag
COOKIE_SECURE=false
